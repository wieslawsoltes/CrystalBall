# Put a LAN DNS A/AAAA record for this hostname on the router.
# No public exposure is required. Do not enable HTTP plaintext device access.
orb-gateway.home.arpa {
    tls internal
    request_body {
        max_size 260KB
    }
    reverse_proxy gateway:8080
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
    }
}
