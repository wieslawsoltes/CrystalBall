# Copy to .env, chmod 600, never commit. OpenAI API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=
# JSON object maps unit ID to SHA256(token); tokens are generated by tools/provision.py.
DEVICE_TOKEN_SHA256={}
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
REQUESTS_PER_MINUTE=8
REQUESTS_PER_DAY=200
PUBLIC_TTS=false
ALLOWED_HOSTS=orb-gateway.home.arpa,localhost,127.0.0.1
