# Generate gateway/.env interactively: python factory/configure_gateway.py
# Never put the project key in a browser, firmware image, ZIP or Git commit.
OPENAI_API_KEY=
DEVICE_TOKEN_SHA256={}
ORB_HOST=orb-gateway.home.arpa
ALLOWED_HOSTS=orb-gateway.home.arpa,localhost,127.0.0.1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
REALTIME_SECONDS=90
REALTIME_ENABLED=false
PUBLIC_TTS=false
REQUESTS_PER_MINUTE=8
REQUESTS_PER_DAY=200
BUDGET_DATABASE=/var/lib/orb/budget.sqlite
WEB_DIRECTORY=/opt/orb/web
# Same-origin deployment needs no CORS entries. Never use wildcard origins.
CORS_ORIGINS=

# Durable call ownership journal. Never delete to clear a failed hangup.
REALTIME_DATABASE=/var/lib/orb/voice.sqlite
